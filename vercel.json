{
  "redirects": [
    {
      "source": "/mapa",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/mapa/index.html"
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "site-output",
  "functions": {
    "api/submit.js": {
      "includeFiles": "fonts/**"
    }
  }
}
